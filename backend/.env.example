PORT=3001
JWT_SECRET=replace-with-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Leave both unset for local dev (uses a local lifelog.db file automatically).
# Set both in production to point at a Turso database instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Web push (evening reminders). Generate once with: npx web-push generate-vapid-keys
# Leave unset locally and a dev key pair is created in backend/.vapid.json automatically.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
